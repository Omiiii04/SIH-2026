# ─────────────────────────────────────────────────────────────────────────────
# SIH-2026 Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="SIH-2026 Orchestrator"
APP_VERSION="0.1.0"
DEBUG=false

# ── Orchestrator server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sih2026
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=change_me_in_production

# ── ChromaDB (vector store) ───────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=conversation_memory

# ── Worker Node URLs (LM Studio endpoints) ────────────────────────────────────
# Add as many NODE_N_URL entries as needed. Numbering can be sparse.
# No code changes are required when adding or removing nodes.
#
# Mandatory per node:
#   NODE_N_URL      — the LM Studio base URL for that laptop
#
# Optional per node (all have sensible defaults):
#   NODE_N_NAME     — display name (default: "Node N")
#   NODE_N_PRIORITY — scheduling priority, 1 = highest (default: 1)
#   NODE_N_ENABLED  — true/false; false keeps the node in the DB but inactive (default: true)
#
# Examples:
NODE_1_URL=http://192.168.1.101:1234
NODE_1_NAME=Orchestrator Laptop
NODE_1_PRIORITY=1

NODE_2_URL=http://192.168.1.102:1234
NODE_2_NAME=Friend Laptop A

NODE_3_URL=http://192.168.1.103:1234
NODE_3_NAME=Friend Laptop B

# Add more as needed — no upper limit, gaps in numbering are fine:
# NODE_4_URL=http://192.168.1.104:1234
# NODE_7_URL=http://192.168.1.107:1234
# NODE_14_URL=http://192.168.1.114:1234
#
# To disable a specific node without removing it:
# NODE_2_ENABLED=false

# ── HTTP client ───────────────────────────────────────────────────────────────
HTTP_TIMEOUT=30.0
HTTP_MAX_RETRIES=3

# ── Health-check ──────────────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL=30
