# ─────────────────────────────────────────────────────────────────────────────
# SIH-2026 Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="SIH-2026 Orchestrator"
APP_VERSION="0.1.0"
DEBUG=false

# ── Orchestrator server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sih2026
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=change_me_in_production

# ── ChromaDB (vector store) ───────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=conversation_memory

# ── Worker Node URLs (LM Studio endpoints) ────────────────────────────────────
# Replace with the actual LAN IPs of your 5 worker laptops.
NODE_TEXT_URL=http://192.168.1.101:1234
NODE_VISION_URL=http://192.168.1.102:1234
NODE_REASONING_URL=http://192.168.1.103:1234
NODE_CODE_URL=http://192.168.1.104:1234
NODE_RAG_URL=http://192.168.1.105:1234

# ── HTTP client ───────────────────────────────────────────────────────────────
HTTP_TIMEOUT=30.0
HTTP_MAX_RETRIES=3

# ── Health-check ──────────────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL=30
